# TEMPLATE ONLY — the application reads `.env`, not `.env.example`.
# Run `npm run setup` once after extracting the project. It creates a local,
# gitignored `.env` from this file without overwriting an existing `.env`.
# Then put your REAL credentials in `.env` and keep that file private.
#
# Do NOT expect the placeholder/blank values in this file to authenticate
# against Telegram or OpenSea. Tests validate this template separately; the
# real runtime test uses your local `.env`.

# --- Required for a real alerting run ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- OpenSea ---
# Your real OpenSea developer key goes in `.env` after running `npm run setup`.
# Instant keys currently have a 60-read/minute free-tier limit and expire after
# 30 days. Use a permanent developer key for production.
# Source: https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=

# poll   = one short cycle then exit (GitHub Actions / cron).
# stream = long-running websocket, real-time.
MODE=poll
STATE_FILE=./state.json
DRY_RUN=
DEBUG=
