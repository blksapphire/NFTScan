# Copy this file to `.env` for local runs. On GitHub Actions these go in
# Settings -> Secrets and variables -> Actions -> New repository secret.
# NEVER commit a real `.env` file.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional locally, REQUIRED for the GitHub Actions poller.
# Instant OpenSea keys currently have a 60-read/minute free-tier limit and
# expire after 30 days. Store a permanent developer key for production.
# Source: https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=

# poll   = one short cycle then exit (GitHub Actions / cron).
# stream = long-running websocket, real-time.
MODE=poll
STATE_FILE=./state.json
DRY_RUN=
DEBUG=
