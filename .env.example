# Copy this file to `.env` for local runs. On GitHub Actions these go in
# Settings -> Secrets and variables -> Actions -> "New repository secret".
# NEVER commit a real .env file.

# --- Required ---

# From @BotFather on Telegram. Looks like 123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID. Message @userinfobot to get it.
TELEGRAM_CHAT_ID=

# --- Optional locally, REQUIRED on GitHub Actions ---

# OpenSea API key. Leave BLANK for local runs and the bot mints itself a free
# key. That does not work on Actions: the free-key endpoint is rate limited per
# IP and runner IPs are shared, so it answers 429 there. Set this secret.
# Free "instant" keys expire after ~7 days and nothing renews them for you —
# `npm run newkey` mints a replacement, `npm run diagnose` checks one.
# Permanent key: opensea.io -> Settings -> Developer (needs a verified,
# non-anonymous email address).
OPENSEA_API_KEY=

# poll   = one short cycle then exit (GitHub Actions / cron). Default.
# stream = long-running websocket, real-time. Needs an always-on machine.
MODE=poll

# Where to keep state between runs.
STATE_FILE=./state.json

# Set to 1 to log alerts to the console instead of sending them to Telegram.
DRY_RUN=

# Set to 1 for verbose HTTP and scoring logs.
DEBUG=
