{
  "name": "opensea-mint-sniper",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram alert bot that finds new OpenSea mints early and scores them like a trading screener. Alert-only: holds no wallet keys.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "once": "node src/index.js --once",
    "dry": "node src/index.js --once --dry-run",
    "stream": "node src/index.js --mode=stream",
    "test:telegram": "node src/index.js --test-telegram",
    "newkey": "node src/index.js --new-key",
    "selftest": "node test/selftest.js",
    "diagnose": "node test/diagnose.js",
    "check": "node --check src/index.js && node --check src/poll.js && node --check src/stream.js"
  },
  "keywords": [
    "opensea",
    "nft",
    "telegram",
    "mint",
    "alerts"
  ],
  "license": "MIT"
}
